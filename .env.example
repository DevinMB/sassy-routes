# Copy to .env and edit. Never commit the real .env.
# `make seed` will create .env from this template automatically (with a random
# CouchDB password) if it doesn't exist yet.

# --- CouchDB (segment scores + route cache; used from Phase 1 on) ---
COUCHDB_USER=apex
COUCHDB_PASSWORD=change-me

# --- Backend ---
# Comma-separated list of allowed browser origins (CORS).
APEX_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173
# Straight-line origin→destination cap, in km (anti-DoS clamp; see CLAUDE-ref §7).
APEX_MAX_ROUTE_DISTANCE_KM=500
# Geocoder for the search box. Default: public Photon instance (OSM data).
# Point at a self-hosted Photon to go fully self-contained.
# APEX_GEOCODER_URL=https://photon.komoot.io

# --- GraphHopper ---
# Java heap for the import/serve process. Fit to host RAM: leave ~2 GB free for
# the rest of the stack (e.g. 5.6 GB host → 3g). Import wants the most; serving
# is fine on less.
GH_JAVA_XMX=3g

# --- Cloudflare tunnel (later; uncomment cloudflared in docker-compose.yml) ---
# TUNNEL_TOKEN=
